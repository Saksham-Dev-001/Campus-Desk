# ===================================================================
#  CampusDesk environment configuration
#  Copy this file to .env and adjust. NEVER commit .env to git.
# ===================================================================

# Flask secret — change this to a long random string in production
SECRET_KEY=change-me-to-a-long-random-string-in-production

# Database — SQLite by default; swap to postgres://... later
DATABASE_URL=sqlite:///campusdesk.db

# Uploads
UPLOAD_FOLDER=./uploads
MAX_UPLOAD_MB=25

# Session security (set to 1 when serving over HTTPS)
SESSION_COOKIE_SECURE=0

# ===================================================================
#  Storage provider
#    "local"    → files written to uploads/storage/<BRANCH>/
#    "telegram" → files stored in a supergroup's forum topics
# ===================================================================
STORAGE_PROVIDER=local

# --- Telegram topic-based storage ---
# Enable by setting STORAGE_PROVIDER=telegram and filling these values.
#
# Step-by-step: see TELEGRAM_SETUP.md
#
#   TELEGRAM_BOT_TOKEN         from @BotFather
#   TELEGRAM_STORAGE_CHAT_ID   negative id of your supergroup (e.g. -1001234567890)
#   TELEGRAM_TOPICS            JSON map of branch code → topic id
#
TELEGRAM_BOT_TOKEN=
TELEGRAM_STORAGE_CHAT_ID=
TELEGRAM_TOPICS={"CSE":5,"CS":7,"AIML":9,"DS":11}
TELEGRAM_API_BASE=https://api.telegram.org
